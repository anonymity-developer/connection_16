# Copy to .env. Replace every change-me value; never commit .env.
DB_NAME=tagme
DB_USER=tagme
DB_PASSWORD=change-me-local-password
DB_ROOT_PASSWORD=change-me-local-root-password
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=8088

# Used only with compose.prod.yml; DNS must point to your VM.
APP_DOMAIN=tagme.example.com

# Enable only after verifying an approved sender account / token and channel permissions.
# Choose EITHER MATTERMOST_TOKEN OR MATTERMOST_LOGIN_ID + MATTERMOST_LOGIN_PASSWORD.
# Choose EITHER MATTERMOST_CHANNEL_ID OR MATTERMOST_TEAM_NAME + MATTERMOST_CHANNEL_NAME.
# Use only the approved sender account; never collect participant Mattermost passwords.
# Never commit credentials. Leave AUTH_ENABLED=false until real integration is authorized.
AUTH_ENABLED=false
# Optional independently provisioned operator; no Mattermost login/DM is used.
# ID uses a separate namespace, e.g. admin:tagme. Password must be 15-64 characters.
# Set AUTH_HMAC_KEY below even when only administrator authentication is enabled.
ADMIN_BOOTSTRAP_ID=
ADMIN_BOOTSTRAP_PASSWORD=
# Generate locally: openssl rand -base64 32. Never commit the result.
AUTH_HMAC_KEY=
AUTH_OTP_TTL_SECONDS=180
AUTH_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_ACCOUNT_LIMIT=5
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_IP_PER_MINUTE=120
# Integration credentials stay server-side; never use browser VITE_ variables.
MATTERMOST_BASE_URL=https://meeting.ssafy.com
MATTERMOST_TOKEN=
MATTERMOST_LOGIN_ID=
MATTERMOST_LOGIN_PASSWORD=
MATTERMOST_CHANNEL_ID=
MATTERMOST_TEAM_NAME=
MATTERMOST_CHANNEL_NAME=
AI_API_KEY=

# Moderation is disabled by default: wishes, cheers and comments publish immediately.
# Provider settings below are dormant until moderation is explicitly enabled later.
# Confirm the GMS OpenAI-compatible base URL (ending in /v1) with SSAFY.
TAGME_MODERATION_PROVIDER=NONE
TAGME_GMS_BASE_URL=
GMS_KEY=
OPENAI_API_KEY=
