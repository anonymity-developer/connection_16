# Copy to .env. Replace every change-me value; never commit .env.
DB_NAME=tagme
DB_USER=tagme
DB_PASSWORD=change-me-local-password
DB_ROOT_PASSWORD=change-me-local-root-password
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=8088

# Used only with compose.prod.yml; DNS must point to your VM.
APP_DOMAIN=tagme.example.com

# Enable only after verifying the dedicated bot/token and channel permissions.
AUTH_ENABLED=false
# Generate locally: openssl rand -base64 32. Never commit the result.
AUTH_HMAC_KEY=
# Integration credentials stay server-side; never use browser VITE_ variables.
MATTERMOST_BASE_URL=https://meeting.ssafy.com
MATTERMOST_TOKEN=
MATTERMOST_CHANNEL_ID=
AI_API_KEY=
