{
  "name": "tagme-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --test tests/*.test.mjs ../scripts/*.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:auth-ui": "node scripts/check-auth-ui.mjs",
    "test:participation-ui": "node scripts/check-participation-ui.mjs",
    "test:results-ui": "node scripts/check-results-ui.mjs",
    "test:content-ui": "node scripts/check-content-ui.mjs",
    "test:reactions-ui": "node scripts/check-reactions-ui.mjs",
    "test:discovery-ui": "node scripts/check-discovery-ui.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "16.5.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
