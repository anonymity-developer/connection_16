# Separate from .env and .env.pr-review. Never commit real values.
# Store the complete file as SSM SecureString /tagme/production/env (standard, <=4 KiB).
DB_NAME=tagme
DB_USER=tagme
DB_PASSWORD=change-me-production-random-password
DB_ROOT_PASSWORD=change-me-production-random-root-password
# Leave empty for an internal deployment with NO published ports.
# For public deployment, use a DNS name only (no scheme/path), pointing to EC2.
APP_DOMAIN=
AUTH_ENABLED=false
ADMIN_BOOTSTRAP_ID=admin:tagme
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-15-characters
AUTH_HMAC_KEY=
MATTERMOST_BASE_URL=https://meeting.ssafy.com
MATTERMOST_TOKEN=
MATTERMOST_LOGIN_ID=
MATTERMOST_LOGIN_PASSWORD=
MATTERMOST_CHANNEL_ID=
MATTERMOST_TEAM_NAME=
MATTERMOST_CHANNEL_NAME=
TAGME_MODERATION_PROVIDER=NONE
